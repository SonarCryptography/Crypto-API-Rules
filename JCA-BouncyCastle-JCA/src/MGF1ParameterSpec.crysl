SPEC java.security.spec.MGF1ParameterSpec

OBJECTS 
	java.lang.String mdName;

EVENTS
	c1: MGF1ParameterSpec(mdName);
	Con := c1;
	
ORDER
	Con

CONSTRAINTS
	mdName in {"SHA-256", "SHA-384", "SHA-512", "SHA3-256", "SHA3-384", "SHA3-512","SHA-512/256"};

//"SHA-512/256" (an approved FIPS 180-4 function with 256-bit output, supported by the JDK)

ENSURES
	preparedMGF1[this, mdName];
