SPEC javax.xml.crypto.dsig.spec.HMACParameterSpec

OBJECTS 
	int outputLen;

EVENTS
	c1: HMACParameterSpec(outputLen);
	Con := c1;
	
ORDER
	Con

CONSTRAINTS
	outputLen >= 128;    
//constraints added: recommended at least 128 (at least 80 for Legacy but not recommended)
	
ENSURES
	preparedHMAC[this];
