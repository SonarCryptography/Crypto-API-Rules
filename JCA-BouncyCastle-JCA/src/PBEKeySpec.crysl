SPEC javax.crypto.spec.PBEKeySpec

OBJECTS 
	char[] password;
	byte[] salt;
	int iterationCount;
	int keyLength; 
	
FORBIDDEN
	PBEKeySpec(char[]) => Con;
	PBEKeySpec(char[],byte[],int) => Con;
	
EVENTS
	c1: PBEKeySpec(password, salt, iterationCount, keyLength);
	Con := c1;
	
	cp1: clearPassword();
	ClearPass := cp1;
	
ORDER
	Con, ClearPass
 	
CONSTRAINTS
	iterationCount >= 220000;
	length[salt] >= 16;
	keyLength >= 128;

	neverTypeOf[password, java.lang.String];
	neverTypeOf[salt, java.lang.String];

	// Disabled `notHardCoded` constraints as they cause false positives
	// The `randomized` requirements is nonetheless stronger and should thus be sufficient
	//notHardCoded[password];
	//notHardCoded[salt];

REQUIRES
	randomized[salt];	

ENSURES
	speccedKey[this, keyLength] after Con;

	// Sets iteration count marker for 256-bit and 512-bit hashes
	iterationCount >= 600000 => pbeKeySpec_minIterCount_sha256[this] after Con;
	iterationCount >= 220000 => pbeKeySpec_minIterCount_sha512[this] after Con;

	// Sets key length marker for 256-bit and 512-bit hashes
	keyLength >= 256 => pbeKeySpec_keyLength_256[this] after Con;
	keyLength >= 512 => pbeKeySpec_keyLength_512[this] after Con;

NEGATES
	speccedKey[this, _] after ClearPass;

	// Clears iteration count marker
	pbeKeySpec_minIterCount_sha256[this] after ClearPass;
	pbeKeySpec_minIterCount_sha512[this] after ClearPass;

	// Clears key length marker
	pbeKeySpec_keyLength_256[this] after ClearPass;
	pbeKeySpec_keyLength_512[this] after ClearPass;
