SPEC javax.crypto.SecretKeyFactory

OBJECTS
	java.lang.String algorithm;
	javax.crypto.SecretKey key;
	javax.crypto.SecretKey otherKey;
	java.security.spec.KeySpec keySpec;
   
EVENTS
	g1: getInstance(algorithm);
	g2: getInstance(algorithm, _);
	Get := g1 | g2;

	gS: key = generateSecret(keySpec);
	tK: key = translateKey(otherKey);
	Gen := gS | tK;

ORDER
	Get, Gen

CONSTRAINTS
	algorithm in {
		"AES",

		"PBKDF2WithHmacSHA256",
		"PBKDF2WithHmacSHA384",
		"PBKDF2WithHmacSHA512",

		"PBEWithHmacSHA256AndAES_128",
		"PBEWithHmacSHA256AndAES_256",

		"PBEWithHmacSHA384AndAES_128",
		"PBEWithHmacSHA384AndAES_256",

		"PBEWithHmacSHA512AndAES_128",
		"PBEWithHmacSHA512AndAES_256",

		// 224-bit hashes are no longer recommended by NIST SP 800-131A Rev. 3 (draft)
		//"PBKDF2WithHmacSHA224",
		//"PBEWithHmacSHA224AndAES_128",
        //"PBEWithHmacSHA224AndAES_256",

		"PBKDF2WITHHMACSHA3-256",
		"PBKDF2WITHHMACSHA3-384",
		"PBKDF2WITHHMACSHA3-512",

		"Camellia"
	};

REQUIRES
	speccedKey[keySpec, _];

	// Requires PBEKeySpec with minimum iteration count for 256-bit hashes
	algorithm in {
		"PBKDF2WithHmacSHA256",
		"PBEWithHmacSHA256AndAES_128",
		"PBEWithHmacSHA256AndAES_256"
	} => pbeKeySpec_minIterCount_sha256[keySpec];

	// Requires PBEKeySpec with minimum iteration count for 512-bit hases
    algorithm in {
    	"PBKDF2WithHmacSHA384",
    	"PBKDF2WithHmacSHA512",
    	"PBEWithHmacSHA384AndAES_128",
    	"PBEWithHmacSHA384AndAES_256",
    	"PBEWithHmacSHA512AndAES_128",
    	"PBEWithHmacSHA512AndAES_256"
    } => pbeKeySpec_minIterCount_sha512[keySpec];

	// Requires PBEKeySpec with key length for 256-bit hashes
	algorithm in {
		"PBKDF2WithHmacSHA256"
	} => pbeKeySpec_keyLength_256[keySpec];

	// Requires PBEKeySpec with key length for 512-bit hases
    algorithm in {
    	"PBKDF2WithHmacSHA384",
    	"PBKDF2WithHmacSHA512"
    } => pbeKeySpec_keyLength_512[keySpec];
	
ENSURES
	generatedKey[key, algorithm];
